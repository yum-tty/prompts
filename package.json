{
    "name":  "@yum-tty/prompts",
    "version": "0.2.0",
    "description":  "Interactive prompts and forms for Bun. A TypeScript port of Huh.",
    "module":  "src/index.ts",
    "type":  "module",
    "main":  "src/index.ts",
    "types":  "src/index.ts",
    "exports":  {
                    ".":  {
                              "import":  "./src/index.ts",
                              "types":  "./src/index.ts"
                          }
                },
    "files":  [
                  "src/**/*",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "dev":  "bun --watch src",
                    "typecheck":  "bun run --bun tsc --noEmit"
                },
    "keywords":  [
                     "prompts",
                     "forms",
                     "input",
                     "select",
                     "confirm",
                     "terminal",
                     "bun"
                 ],
    "author":  "yum-tty",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/yum-tty/prompts"
                   },
    "devDependencies":  {
                            "@types/bun":  "^1.3.14",
                            "@types/node":  "^26.0.0",
                            "bun-types":  "^1.3.14"
                        },
    "dependencies":  {
                         "@yum-tty/caramel":  "^0.1.0",
                         "@yum-tty/cinnamon-bun":  "^0.1.0",
                         "@yum-tty/cinnamon":  "^0.1.0"
                     },
    "publishConfig":  {
                          "access":  "public"
                      }
}
